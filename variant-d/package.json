{
  "name": "@exct/eve-dogma-ts",
  "version": "0.1.0",
  "description": "EXCT dogma lab - Variant D: stateless EVE Online fitting engine in TypeScript (Node + browser, zero runtime deps)",
  "license": "LGPL-3.0-or-later",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "eve-dogma-ts": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p . && tsc -p tsconfig.browser.json && tsc -p tsconfig.cli.json && node tools/bundle.mjs",
    "build:node": "tsc -p .",
    "test": "npm run build && node dist/test/parity.js",
    "bench": "npm run build && node dist/bench/bench.js",
    "build:web": "tsc -p tsconfig.browser.json && node tools/bundle.mjs",
    "check:web": "node tools/bundle-check.mjs ../../data/dataset-3569502.json.gz ../../eve-dogma-bench/cases"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^20.0.0"
  }
}
